<?xml version="1.0" encoding="utf-8"?>
<!-- Lapisan depan ikon adaptif (Android 8.0+). Path sama persis dengan
     ic_splash_logo.xml — sumbernya tetap satu berkas,
     apps/mobile/brand/wangsa_logo.svg.

     Kanvas ikon adaptif berukuran 108dp, tapi sistem hanya menjamin area
     lingkaran di tengah berdiameter 66dp yang selalu terlihat setelah
     dipotong bentuk peluncur (lingkaran, persegi membulat, tetesan air,
     dsb, tergantung merek ponsel). Skala 0.62 pada viewport 600x600
     dipakai supaya logo muat di dalam area aman itu dengan sisa jarak,
     bukan skala 0.8 seperti di layar pembuka yang kanvasnya sendiri
     sudah dipotong lingkaran oleh layer-list. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="600"
    android:viewportHeight="600">

    <group
        android:pivotX="300"
        android:pivotY="300"
        android:scaleX="0.62"
        android:scaleY="0.62">

        <!-- Sama dengan transform SVG aslinya:
             translate(0,600) scale(0.05,-0.05). -->
        <group
            android:scaleX="0.05"
            android:scaleY="-0.05"
            android:translateY="600">

