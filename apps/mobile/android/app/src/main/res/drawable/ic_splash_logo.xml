<?xml version="1.0" encoding="utf-8"?>
<!-- Logo Wangsa untuk layar pembuka. Diterjemahkan tangan dari
     apps/mobile/brand/wangsa_logo.svg, karena Android tidak bisa memakai
     SVG secara langsung. Kalau logonya berubah, ubah berkas SVG itu lalu
     salin ulang pathData di bawah.

     Warnanya sengaja terang (#FAFAFA, foreground tema gelap di
     DESIGN.md) agar terbaca di latar splash_background yang gelap. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="480dp"
    android:height="480dp"
    android:viewportWidth="600"
    android:viewportHeight="600">

    <!-- Android 12 ke atas memotong ikon layar pembuka menjadi lingkaran
         berdiameter dua pertiga ukurannya. Logo diperkecil 80 persen dari
         titik tengah supaya ujung-ujungnya tidak ikut terpotong. -->
    <group
        android:pivotX="300"
        android:pivotY="300"
        android:scaleX="0.8"
        android:scaleY="0.8">

        <!-- Sama dengan transform SVG aslinya:
             translate(0,600) scale(0.05,-0.05). VectorDrawable menerapkan
             skala lebih dulu, baru translasi, sama seperti urutan SVG. -->
        <group
            android:scaleX="0.05"
            android:scaleY="-0.05"
            android:translateY="600">

            <path
                android:fillColor="@color/splash_logo"
                android:pathData="M6009 8553 c-525 -134 -768 -664 -569 -1242 48 -140 122 -261 302 -491 320 -410 384 -677 251 -1058 -118 -339 -612 -1021 -639 -882 -207 1069 -524 1535 -1484 2180 -387 259 -1299 777 -1325 752 -20 -20 182 -505 383 -922 285 -589 536 -1012 1411 -2380 190 -297 427 -668 526 -825 99 -157 187 -285 196 -285 8 0 230 319 492 710 262 390 483 710 490 710 7 0 43 -46 79 -103 l66 -104 118 129 c697 760 672 1366 -90 2174 -432 458 -541 733 -391 987 125 213 283 223 669 41 476 -224 626 -245 457 -61 -112 120 -173 228 -242 423 -72 207 -402 323 -700 247z" />

            <path
                android:fillColor="@color/splash_logo"
                android:pathData="M9210 7689 c-1494 -807 -2082 -1340 -2281 -2069 -153 -561 -230 -748 -440 -1062 -71 -107 -129 -199 -129 -205 0 -7 588 -942 610 -968 2 -3 39 51 81 120 42 69 325 517 629 995 906 1426 1073 1706 1357 2275 173 344 482 1065 458 1065 -3 0 -131 -68 -285 -151z" />
        </group>
    </group>
</vector>
