<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <!-- The INTERNET permission is required for development. Specifically,
         the Flutter tool needs it to communicate with the running application
         to allow setting breakpoints, to provide hot reload, etc.
    -->
    <uses-permission android:name="android.permission.INTERNET"/>

    <!-- HANYA UNTUK DEBUG. Sejak Android 9, koneksi tanpa enkripsi
         ditolak diam-diam, sehingga aplikasi tidak akan bisa memanggil
         API Wangsa di http://10.0.2.2 maupun di alamat IP jaringan lokal
         saat pengembangan. Berkas ini hanya dipakai pada build debug,
         jadi build rilis tetap menolak koneksi tanpa enkripsi dan wajib
         memakai HTTPS. Lihat apps/mobile/README.md. -->
    <application
        android:usesCleartextTraffic="true"
        tools:replace="android:usesCleartextTraffic" />
</manifest>
