  "narrative": {
    "northStar": "Native Operate UI",
    "overview": "Wangsa Mobile preserves the incumbent Android Material 3 interface: bundled Roboto, indigo actions, neutral reading surfaces, and restrained outlines. Its character is calm and practical. The existing Wangsa logo remains the identity asset; this record introduces no new visual identity.\n\nThe product extension uses the existing WangsaTheme rather than defining a second theme. Native controls, readable text, and generous vertical separation carry the hierarchy. Authentication, jobs, results, and procedures share that grammar.",
    "keyCharacteristics": [
      "A single indigo action accent with neutral supporting information.",
      "Native Material controls and a shared Roboto hierarchy.",
      "Flat reading surfaces, thin separators, and a bounded scrolling column."
    ],
    "rules": [
      {
        "name": "The Existing Theme Rule",
        "body": "Resolve screen colors through WangsaTheme and ColorScheme; extend the incumbent identity instead of inventing a second palette.",
        "section": "colors"
      },
      {
        "name": "The Role Before Size Rule",
        "body": "Use the inherited TextTheme roles for headings, body copy, and labels instead of individually sizing each screen.",
        "section": "typography"
      },
      {
        "name": "The Flat Reading Surface Rule",
        "body": "Keep app bars and reading surfaces flat; use spacing, text hierarchy, and thin dividers to separate content.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do use the shared ProductBody column for product screens.",
      "Do use the shared 48 logical-pixel minimum button size for main form actions.",
      "Do pair job status text with its native status icon; color alone is insufficient.",
      "Do keep long results and procedures selectable and scrollable.",
      "Do preserve the bundled Roboto family and existing Wangsa logo."
    ],
    "donts": [
      "Don't replace native product controls with a new brand treatment.",
      "Don't present every job as a raised card; the shipped collection uses divided list rows.",
      "Don't hard-code light colors into widgets that already consume ColorScheme.",
      "Don't treat generated palette ramps or HTML previews as new Flutter theme tokens."
    ]
  }
}
